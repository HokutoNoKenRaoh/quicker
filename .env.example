# Signs the guest cookie that lets a browser find its lobby seat again (32+ random characters).
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
QUICKER_GUEST_SECRET=

# Behind a reverse proxy that sets X-Real-IP / X-Forwarded-For: true enables the per-network limits.
# Leave unset when the app is reached directly (the headers could be forged).
QUICKER_TRUST_PROXY=
